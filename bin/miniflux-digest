#!/usr/bin/env bash
# Build an EPUB of new entries from selected Miniflux feeds and add it to
# Calibre. Remembers the newest entry sent, so each digest only has entries
# not sent before. Read/unread status in Miniflux is left alone.
set -euo pipefail

repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

# MINIFLUX_URL, MINIFLUX_FEED_IDS, MINIFLUX_INITIAL_DAYS, CALIBRE_SERVER_PORT;
# see config.example.
set -a
. "$HOME/.config/miniflux-digest/config"
set +a
STATE_FILE=$HOME/.local/state/miniflux-digest/last-entry-id
LIBRARY="$HOME/Calibre Library"
SERVER_PORT=${CALIBRE_SERVER_PORT:-8081}
KEEP_DAYS=${MINIFLUX_KEEP_DAYS:-14}

# calibredb cannot open the library directly while the GUI or calibre-server
# holds it, so go through the content server when it is up.
if ss -tln | grep -q ":$SERVER_PORT "; then
  target="http://localhost:$SERVER_PORT/#${LIBRARY##*/}"
  target=${target// /_}
else
  target=$LIBRARY
fi

# Drop digests added more than KEEP_DAYS ago. calibredb remove puts them in
# Calibre's trash, so a mistake can still be undone from the GUI for a while.
old=$(calibredb search --with-library "$target" \
  "title:\"~^Miniflux (digest|catch-up)\" and date:<${KEEP_DAYS}daysago" 2>/dev/null || true)
if [ -n "$old" ]; then
  calibredb remove --with-library "$target" "$old"
  echo "Removed digests older than $KEEP_DAYS days: $old"
fi

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
export MINIFLUX_ENTRIES_FILE=$out/entries.json

count=$(python3 -I "$repo/lib/fetch_entries.py" "$STATE_FILE" "$out")
if [ "$count" -eq 0 ]; then
  echo "No new entries, nothing to do."
  exit 0
fi

epub="$out/Miniflux digest $(date +%F).epub"
ebook-convert "$repo/recipes/miniflux.recipe" "$epub"
calibredb add --with-library "$target" "$epub"

# Only advance after the EPUB is in Calibre, so a failed run is retried.
mkdir -p "$(dirname "$STATE_FILE")"
cp "$out/last-entry-id" "$STATE_FILE"
echo "Added $count entries."
