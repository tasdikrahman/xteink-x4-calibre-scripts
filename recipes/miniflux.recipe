import json
import os
from datetime import datetime
from html import escape

from calibre.ptempfile import PersistentTemporaryFile
from calibre.web.feeds.news import BasicNewsRecipe

# Written by lib/fetch_entries.py; path exported by bin/miniflux-digest.
ENTRIES_FILE = os.environ['MINIFLUX_ENTRIES_FILE']
# "feed": one section per feed. "day": one section per publication day,
# for digests that are mostly a single feed.
GROUP_BY = os.environ.get('MINIFLUX_GROUP_BY', 'feed')


class MinifluxDigest(BasicNewsRecipe):
    # Also drawn on the generated cover, so each profile's books look distinct.
    title = os.environ.get('MINIFLUX_DIGEST_TITLE', 'Miniflux digest')
    description = 'New entries from selected Miniflux feeds'
    language = 'en'
    no_stylesheets = True
    auto_cleanup = False
    remove_javascript = True
    max_articles_per_feed = 100
    oldest_article = 365

    # Small e-ink screen (Xteink X4 is 480x800): shrink and recompress images,
    # which is most of a digest's file size.
    scale_news_images_to_device = False
    scale_news_images = (480, 800)
    compress_news_images = True

    def parse_index(self):
        entries = json.load(open(ENTRIES_FILE))

        sections = {}
        for e in entries:
            # Use the content Miniflux already stored (full text when
            # "Fetch original content" is on) instead of re-fetching the site.
            title = escape(e['title'])
            html = (f'<html><head><meta charset="utf-8"><title>{title}</title></head><body>'
                    f'<h1>{title}</h1>'
                    f'<p><i>{escape(e["feed"]["title"])} · {e["published_at"][:10]}</i></p>'
                    f'{e["content"]}'
                    f'<p><small>{e["url"]}</small></p></body></html>')
            pt = PersistentTemporaryFile('.html')
            pt.write(html.encode('utf-8'))
            pt.close()
            if GROUP_BY == 'day':
                section = datetime.fromisoformat(e['published_at']).strftime('%a %d %b')
            else:
                section = e['feed']['title']
            sections.setdefault(section, []).append({
                'title': e['title'],
                'url': 'file://' + pt.name,
                'date': e['published_at'][:10],
                'description': '',
            })
        return list(sections.items())
