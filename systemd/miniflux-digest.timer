[Unit]
Description=Daily Miniflux EPUB digest

[Timer]
# Hourly, not daily: the laptop is rarely awake at a fixed time. The script
# exits early once it has succeeded today, so this still means one digest a
# day, and a failed attempt (no network yet, library locked) is retried next hour.
OnCalendar=hourly
# Fire on boot/login if an hour boundary passed while powered off.
Persistent=true

[Install]
WantedBy=timers.target
